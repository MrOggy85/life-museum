{
  "tasks": {
    "curate": "deno run --allow-read --allow-write --allow-run=claude --allow-ffi --allow-env curate/main.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-ffi --allow-env",
    "check": "deno check curate/main.ts render/main.ts",
    "render": "deno run --allow-read --allow-write --allow-ffi --allow-env render/main.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": true
  }
}
